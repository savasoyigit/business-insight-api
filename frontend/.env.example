# Base URL of the Business Insight API. Leave empty to use the Vite dev proxy (same origin).
VITE_API_BASE_URL=
# Where the dev proxy forwards /api calls.
VITE_PROXY_TARGET=http://localhost:8080
# "true" builds a static, backend-less showcase that only runs the in-browser demo API (used by `npm run build:demo`).
VITE_DEMO_ONLY=false
# The production build (`npm run build`) leaves the demo sandbox out; "true" keeps it next to the live API.
VITE_ENABLE_DEMO=false
