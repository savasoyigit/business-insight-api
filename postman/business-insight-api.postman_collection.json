{
  "info": {
    "name": "Business Insight API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"username\": \"{{registerUsername}}\",\n  \"password\": \"{{registerPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Insight",
      "item": [
        {
          "name": "List Data Sources",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/insight/data-sources?orgId={{orgId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "insight",
                "data-sources"
              ],
              "query": [
                {
                  "key": "orgId",
                  "value": "{{orgId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Execution",
          "item": [
            {
              "name": "Create Data Source",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/insight/data-sources?orgId={{orgId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "insight",
                    "data-sources"
                  ],
                  "query": [
                    {
                      "key": "orgId",
                      "value": "{{orgId}}"
                    }
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"{{dataSourceName}}\",\n  \"type\": \"POSTGRES\",\n  \"host\": \"{{dataSourceHost}}\",\n  \"port\": {{dataSourcePort}},\n  \"databaseName\": \"{{dataSourceDatabase}}\",\n  \"username\": \"{{dataSourceUsername}}\",\n  \"secretRef\": \"{{dataSourceSecretRef}}\",\n  \"options\": {\n    \"ssl\": false\n  }\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const json = pm.response.json();",
                      "pm.collectionVariables.set('dataSourceId', json.id);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Create Query Template",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/insight/query-templates?orgId={{orgId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "insight",
                    "query-templates"
                  ],
                  "query": [
                    {
                      "key": "orgId",
                      "value": "{{orgId}}"
                    }
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"dataSourceId\": {{dataSourceId}},\n  \"name\": \"{{queryTemplateName}}\",\n  \"description\": \"Execution routing smoke test\",\n  \"sqlText\": \"select current_date as run_date where current_date >= :startDate\",\n  \"parameters\": [\n    { \"name\": \"startDate\", \"type\": \"date\", \"required\": true }\n  ],\n  \"outputSchema\": [\n    { \"name\": \"run_date\", \"type\": \"date\" }\n  ]\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const json = pm.response.json();",
                      "pm.collectionVariables.set('queryTemplateId', json.id);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Validate Query Execution",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/insight/query-execution/validate?orgId={{orgId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "insight",
                    "query-execution",
                    "validate"
                  ],
                  "query": [
                    {
                      "key": "orgId",
                      "value": "{{orgId}}"
                    }
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"queryTemplateId\": {{queryTemplateId}},\n  \"params\": {\n    \"startDate\": \"{{startDate}}\"\n  }\n}"
                }
              }
            },
            {
              "name": "Execute Query Template",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/insight/query-execution/execute?orgId={{orgId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "insight",
                    "query-execution",
                    "execute"
                  ],
                  "query": [
                    {
                      "key": "orgId",
                      "value": "{{orgId}}"
                    }
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"queryTemplateId\": {{queryTemplateId}},\n  \"params\": {\n    \"startDate\": \"{{startDate}}\"\n  },\n  \"snapshot\": true\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const json = pm.response.json();",
                      "pm.collectionVariables.set('queryRunId', json.queryRunId);",
                      "pm.collectionVariables.set('snapshotId', json.snapshotId);"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "RBAC Admin",
      "item": [
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
