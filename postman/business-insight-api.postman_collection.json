            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Permissions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/rbac/permissions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "rbac",
                "permissions"
              ]
            }
          }
        },
        {
          "name": "Create Role ANALYST",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/rbac/roles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "rbac",
                "roles"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ANALYST\",\n  \"description\": \"Read-only analyst role\"\n}"
            }
          }
        },
        {
          "name": "Set Role Permissions",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/rbac/roles/{{roleId}}/permissions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "rbac",
                "roles",
                "{{roleId}}",
                "permissions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permissionCodes\": [\n    \"INSIGHT_DS_READ\",\n    \"INSIGHT_QT_READ\"\n  ]\n}"
            }
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/rbac/users?query={{userQuery}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "rbac",
                "users"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "{{userQuery}}"
                }
              ]
            }
          }
        },
        {
          "name": "Assign Role To User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/rbac/users/{{userId}}/roles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "rbac",
                "users",
                "{{userId}}",
                "roles"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roleNames\": [\"ANALYST\"]\n}"
            }
          }
        }
      ]
    }
  ],
