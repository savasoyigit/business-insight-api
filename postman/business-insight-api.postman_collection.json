                    "insight",
                    "query-templates"
                  ],
                  "query": [
                    {
                      "key": "orgId",
                      "value": "{{orgId}}"
                    }
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"dataSourceId\": {{dataSourceId}},\n  \"name\": \"{{queryTemplateName}}\",\n  \"description\": \"Execution routing smoke test\",\n  \"sqlText\": \"select current_date as run_date where current_date >= :startDate\",\n  \"parameters\": [\n    { \"name\": \"startDate\", \"type\": \"date\", \"required\": true }\n  ],\n  \"outputSchema\": [\n    { \"name\": \"run_date\", \"type\": \"date\" }\n  ]\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const json = pm.response.json();",
                      "pm.collectionVariables.set('queryTemplateId', json.id);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Validate Query Execution",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/insight/query-execution/validate?orgId={{orgId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "insight",
                    "query-execution",
                    "validate"
                  ],
                  "query": [
                    {
                      "key": "orgId",
                      "value": "{{orgId}}"
                    }
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"queryTemplateId\": {{queryTemplateId}},\n  \"params\": {\n    \"startDate\": \"{{startDate}}\"\n  }\n}"
                }
              }
            },
            {
              "name": "Execute Query Template",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/insight/query-execution/execute?orgId={{orgId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "insight",
                    "query-execution",
                    "execute"
                  ],
                  "query": [
                    {
                      "key": "orgId",
                      "value": "{{orgId}}"
                    }
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"queryTemplateId\": {{queryTemplateId}},\n  \"params\": {\n    \"startDate\": \"{{startDate}}\"\n  },\n  \"snapshot\": true\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const json = pm.response.json();",
                      "pm.collectionVariables.set('queryRunId', json.queryRunId);",
                      "pm.collectionVariables.set('snapshotId', json.snapshotId);"
                    ]
                  }
                }
              ]
            }
            ,
            {
              "name": "List Query Runs (Paged)",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/insight/query-execution/runs?orgId={{orgId}}&page={{page}}&size={{size}}&sort={{runSort}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "insight",
                    "query-execution",
                    "runs"
                  ],
                  "query": [
                    {
                      "key": "orgId",
                      "value": "{{orgId}}"
                    },
                    {
                      "key": "page",
                      "value": "{{page}}"
                    },
                    {
                      "key": "size",
                      "value": "{{size}}"
                    },
                    {
                      "key": "sort",
                      "value": "{{runSort}}"
                    }
                  ]
                }
              }
            }
          ]
        },
