                "insight",
                "data-sources"
              ],
              "query": [
                {
                  "key": "orgId",
                  "value": "{{orgId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Execution",
          "item": [
            {
              "name": "Create Data Source",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
